LLM_PROVIDER=groq

GROQ_API_KEY=GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: switch to xAI Grok later by setting LLM_PROVIDER=xai
# XAI_API_KEY=xxxx
# XAI_MODEL=grok-4

# Agent-specific models (leave blank to use GROQ_MODEL)
MODEL_MANAGER=openai/gpt-oss-20b
MODEL_RISK=openai/gpt-oss-20b
MODEL_SAST=openai/gpt-oss-20b
MODEL_PENTEST=openai/gpt-oss-20b
MODEL_IMPLEMENTER=openai/gpt-oss-20b
MODEL_CRYPTO=openai/gpt-oss-20b